{
  "name": "Cloudflare R2 Client",
  "private": true,
  "version": "0.3.23",
  "scripts": {
    "dev": "bun run assets:file-viewer && bun run assets:monaco && next dev --turbopack -p 3000",
    "build": "bun run assets:file-viewer && bun run assets:monaco && next build",
    "start": "next start",
    "tauri": "tauri",
    "assets:file-viewer": "node scripts/copy-file-viewer-assets.mjs",
    "assets:monaco": "node scripts/copy-monaco-assets.mjs",
    "ffmpeg:fetch": "bun scripts/fetch-ffmpeg.ts",
    "tauri:dev": "bun run ffmpeg:fetch && TAURI_CONNECTOR_PORT=9568 TAURI_CONNECTOR_MCP_PORT=9567 tauri dev --features connector",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/lib-storage": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@file-viewer/core": "3.3.3",
    "@file-viewer/react-full": "3.3.3",
    "@monaco-editor/react": "^4.7.0",
    "@smithy/fetch-http-handler": "^5.8.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@zumer/snapdom": "^3.7.4",
    "antd": "^6.7.0",
    "framer-motion": "^14.12.0",
    "i18next": "^27.1.1",
    "marked": "^18.2.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.6",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-virtuoso": "^4.18.21",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.2",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~7.0.2"
  }
}
