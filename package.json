{
  "name": "Cloudflare R2 Client",
  "private": true,
  "version": "0.3.16",
  "scripts": {
    "dev": "bun run assets:file-viewer && bun run assets:monaco && next dev --turbopack -p 3000",
    "build": "bun run assets:file-viewer && bun run assets:monaco && next build",
    "start": "next start",
    "tauri": "tauri",
    "assets:file-viewer": "node scripts/copy-file-viewer-assets.mjs",
    "assets:monaco": "node scripts/copy-monaco-assets.mjs",
    "tauri:dev": "tauri dev --features connector",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run typecheck && bun test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/lib-storage": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@file-viewer/core": "3.2.2",
    "@file-viewer/react-full": "3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@smithy/fetch-http-handler": "^5.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@zumer/snapdom": "^3.4.0",
    "antd": "^6.6.8",
    "framer-motion": "^14.6.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.3",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.19",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-video-thumbnail": "^0.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.2",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~7.0.2"
  }
}
