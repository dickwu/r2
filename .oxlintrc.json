{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "nextjs", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.3.1"
    },
    "next": {
      "rootDir": "."
    }
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "dist/**",
    "build/**",
    ".build/**",
    "src-tauri/**",
    "public/file-viewer/**",
    "public/monaco-editor/**",
    "public/**/*.min.js",
    "public/**/*.min.css",
    ".tmp/**",
    "next-env.d.ts",
    "**/*.min.js",
    "**/*.min.css"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "env": {
        "jest": true
      }
    }
  ],
  "rules": {}
}
